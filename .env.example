# Required for Gemini-backed features.
GEMINI_API_KEY=your_gemini_api_key_here

# Current Gemini model. You can change this without editing Python.
GEMINI_MODEL=gemini-3.8-flash

# Keep this as "gemini" for the default lightweight setup.
AI_PROVIDER=gemini
EXPLANATION_PROVIDER=gemini

# Only used when EXPLANATION_PROVIDER=local.
LOCAL_EXPLANATION_MODEL=MBZUAI/LaMini-Flan-T5-783M

# Safety/validation limit for submitted text.
MAX_INPUT_CHARS=20000
